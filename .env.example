# ==============================================================================
# AI Outbound Calling Platform - Environment Configuration
# ==============================================================================

# Server Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Database Configuration (MongoDB)
DATABASE_URL=mongodb://localhost:27017/ai_calling?directConnection=true

# Redis Configuration (BullMQ / Caching / Rate Limiting)
REDIS_URL=redis://localhost:6379

# Twilio Credentials & Settings
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
# When true, skips Twilio webhook signature verification for local testing
TWILIO_VALIDATE_WEBHOOK=false

# Public URL for Webhooks (Required for Twilio to reach local server via ngrok or live domain)
# Example: https://abc123xyz.ngrok-free.app (No trailing slash)
PUBLIC_BASE_URL=http://localhost:3000

# OpenAI Configuration (For Realtime Voice Agent in upcoming milestones)
OPENAI_API_KEY=sk-proj-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
OPENAI_MODEL=gpt-4o-realtime-preview-2024-10-01
OPENAI_VOICE=alloy

# Call Queue & Rate Limiting Settings
MAX_CONCURRENT_CALLS=5
CALLS_PER_MINUTE=20

# CSR / Human Handoff Configuration
CSR_PHONE_NUMBER=+1XXXXXXXXXX
COMPANY_NAME=ACME Support

# Features
ENABLE_CALL_RECORDING=false
ENABLE_AMD=false

# Weekly Recurring Calling Automation
ENABLE_WEEKLY_CHECKIN=true
WEEKLY_CHECKIN_DAY=MONDAY
WEEKLY_CHECKIN_TIME=10:00
